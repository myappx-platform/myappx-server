Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: iDempiere Postgresql Provider
Bundle-SymbolicName: org.compiere.db.postgresql.provider;singleton:=true
Bundle-Version: 14.0.0.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=17))"
Bundle-ClassPath: .
Require-Bundle: org.adempiere.base;bundle-version="14.0.0",
 org.adempiere.install;bundle-version="14.0.0";resolution:=optional,
 com.zaxxer.HikariCP;bundle-version="7.0.2",
 org.postgresql.jdbc;bundle-version="42.7.8"
Import-Package: org.osgi.framework;version="1.10.0",
 org.slf4j,
 org.w3c.dom,
 javax.crypto,
 javax.crypto.spec,
 javax.management,
 javax.naming,
 javax.net,
 javax.net.ssl,
 javax.security.sasl,
 javax.sql,
 javax.xml.parsers
Bundle-ActivationPolicy: lazy
Bundle-Activator: org.adempiere.db.postgresql.PostgreSQLBundleActivator
Service-Component: OSGI-INF/*.xml
Automatic-Module-Name: org.compiere.db.postgresql.provider
Bundle-Vendor: iDempiere Community
Export-Package: org.adempiere.db.postgresql.config,
 org.compiere.dbPort
